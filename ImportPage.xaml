<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalBookManager.ImportPage"
             Title="Import Books">

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
        <HorizontalStackLayout Grid.Row="0" Margin="0,10,0,20">
            <Label Text="📁" FontSize="30" VerticalOptions="Center"/>
            <Label Text=" Import Books" FontSize="20" VerticalOptions="Center" Margin="10,0,0,0" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <CollectionView x:Name="FileCollectionView" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="3*, *, *" Padding="5,10" Margin="0,0,0,5" BackgroundColor="#F9F9F9">
                        <Label Grid.Column="0" Text="{Binding Title}" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding FileType}" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding FileSize}" TextColor="Gray" HorizontalOptions="End" VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,20,0,10">
            <Button Grid.Column="0" Text="Confirm" BorderColor="Black" BorderWidth="1" BackgroundColor="White" TextColor="Black" Clicked="OnConfirmClicked" />
            <Button Grid.Column="1" Text="Back" BorderColor="Black" BorderWidth="1" BackgroundColor="White" TextColor="Black" Clicked="OnBackClicked" />
        </Grid>
    </Grid>
</ContentPage>